-- Full bundled Hub under a deterministic client. No server/renderer is simulated.
local newWorld=require('./mock_roblox')
return function(source)
    local passed=0
    local function test(name,fn)
        local ok,err=pcall(fn);assert(ok,name..': '..tostring(err))
        passed+=1;print('PASS disaster integration: '..name)
    end
    local function equal(a,b)assert(a==b,tostring(a)..' ~= '..tostring(b))end
    local function find(g,n)return assert(g:FindFirstChild(n,true),n)end
    local function click(g,n)find(g,n).Activated:Fire()end
    local function make(w,class,name,parent,props)
        local o=w.env.Instance.new(class);o.Name=name
        for k,v in pairs(props or {})do o[k]=v end
        o.Parent=parent;return o
    end
    local function launch(setup,width,height)
        local w=newWorld();w.httpFailure=true;w.viewport={X=width or 1280,Y=height or 720}
        local c,h,r=w.character();h.RigType=w.env.Enum.HumanoidRigType.R15
        local storage=w.env.game:GetService('ReplicatedStorage')
        if setup then setup(w,storage,c,h,r)end
        local g=w.run(source);w.step(35)
        return w,g,c,h,r,storage
    end
    local function tag(w,value,c)return make(w,'StringValue','SurvivalTag',c or w.player.Character,{Value=value})end
    local function notices(g)return g:GetAttribute('DisasterNoticeCount')end
    local function text(g)return g:GetAttribute('DisasterNoticeText')end
    local function dispose(w,g)
        g:Destroy()
        local f=w.pg:FindFirstChild('FlyDBZ');if f then f:Destroy()end
        for _,s in pairs(w.services.RunService)do equal(s:Count(),0)end
        equal(w.env.workspace.DescendantAdded:Count(),0);equal(w.env.workspace.DescendantRemoving:Count(),0)
        equal(w.player.CharacterAdded:Count(),0);equal(w.player.CharacterRemoving:Count(),0)
    end
    test('OFF by default, manual immediately below, original columns and no standalone GUI',function()
        for _,size in ipairs({{1920,1080},{844,390},{390,780},{320,640}})do
            local w,g=launch(nil,size[1],size[2]);click(g,'Tab_Main');w.step(25)
            local toggle,manual=find(g,'DisasterPrediction'),find(g,'DisasterPredictionManual')
            equal(find(toggle,'ToggleCaption').Text,'Disaster Prediction');equal(find(toggle,'ToggleStatus').Text,'OFF')
            equal(toggle.Parent.Name,'ToggleOptions');equal(manual.Parent,toggle.Parent)
            assert(manual.Position.Y.Offset>=toggle.Position.Y.Offset+toggle.Size.Y.Offset+10)
            assert(manual.Size.Y.Offset>=44);assert(find(g,'MainColumns').Size.Y.Offset>=manual.Position.Y.Offset+manual.Size.Y.Offset)
            equal(find(g,'FlySS3FE').Parent.Name,'ExecutableOptions')
            equal(w.pg:FindFirstChild('ReyznDisasterPrediction'),nil)
            equal(find(g,'DisasterNotification').Visible,false);equal(notices(g),0)
            equal(w.services.RunService.Heartbeat:Count(),1);equal(g:GetAttribute('Version'),'1.0')
            dispose(w,g)
        end
    end)
    test('automatic switch uses the working tag signal and merges duplicate multi-disasters',function()
        local w,g=launch();local t=tag(w,'');click(g,'DisasterPrediction');w.step(10)
        t.Value='Tsunami, Meteor';w.step(10)
        equal(text(g),'Meteor Shower · Tsunami');equal(notices(g),1)
        w.player.Character:SetAttribute('CurrentDisaster','Tsunami');w.step(10);equal(notices(g),1)
        equal(find(find(g,'DisasterPrediction'),'ToggleStatus').Text,'ON')
        click(g,'DisasterPrediction');w.step(15);assert(not find(g,'DisasterNotification').Visible)
        t.Value='Fire';w.step(10);equal(notices(g),1);equal(t:GetPropertyChangedSignal('Value'):Count(),0)
        dispose(w,g)
    end)
    test('migration removes the old standalone window and runs its cleanup',function()
        local cleaned=false
        local w,g=launch(function(w)
            local old=make(w,'ScreenGui','ReyznDisasterPrediction',w.pg)
            old.Destroying:Connect(function()cleaned=true end)
        end)
        assert(cleaned);equal(w.pg:FindFirstChild('ReyznDisasterPrediction'),nil)
        equal(g:GetAttribute('DisasterPredictionEnabled'),false);dispose(w,g)
    end)
    test('manual works with automatic OFF and releases temporary observers',function()
        local w,g=launch(function(w)tag(w,'Tornado')end)
        click(g,'DisasterPredictionManual');w.step(10)
        equal(text(g),'Tornado');equal(g:GetAttribute('DisasterNoticeKind'),'detected')
        equal(g:GetAttribute('DisasterPredictionEnabled'),false)
        equal(w.services.RunService.Heartbeat:Count(),1);equal(w.env.workspace.DescendantAdded:Count(),0)
        equal(w.player.Character:FindFirstChild('SurvivalTag'):GetPropertyChangedSignal('Value'):Count(),0)
        dispose(w,g)
    end)
    test('manual checks use a four-second monotonic cooldown even on errors and forced clicks',function()
        local w,g=launch();click(g,'DisasterPredictionManual');w.step(10)
        equal(text(g),'Error, You are not in an active round');equal(notices(g),1)
        local b=find(g,'DisasterPredictionManual');equal(b:GetAttribute('CooldownRemaining'),4);assert(not b.Active)
        for _=1,20 do b.Activated:Fire()end;w.step(200);equal(notices(g),1)
        w.step(35);assert(b.Active);equal(b:GetAttribute('CooldownRemaining'),0)
        b.Activated:Fire();w.step(10);equal(notices(g),2);dispose(w,g)
    end)
    test('dead, missing, void and lobby characters cannot reuse a global current disaster',function()
        for _,mode in ipairs({'dead','missing','void','lobby'})do
            local w,g,c,h,r,rs=launch()
            make(w,'StringValue','CurrentDisaster',rs,{Value='Tsunami'})
            if mode~='lobby'then tag(w,'Tsunami')end
            if mode=='dead'then h.Health=0
            elseif mode=='missing'then c.Parent=nil
            elseif mode=='void'then r.CFrame=w.env.CFrame.new(0,-600,0)end
            click(g,'DisasterPredictionManual');w.step(10)
            equal(text(g),'Error, You are not in an active round');dispose(w,g)
        end
    end)
    test('explicit participation can use live state; waiting does not invent a disaster',function()
        local w,g,_,_,_,rs=launch();w.player:SetAttribute('InRound',true)
        click(g,'DisasterPredictionManual');w.step(10)
        equal(text(g),'Disaster data is not available yet');equal(g:GetAttribute('DisasterNoticeKind'),'waiting')
        w.step(240);make(w,'StringValue','NextDisaster',rs,{Value='Acidrain'})
        click(g,'DisasterPredictionManual');w.step(10);equal(text(g),'Acid Rain');dispose(w,g)
    end)
    test('intermission and explicit non-participation override leftover character tags',function()
        for _,mode in ipairs({'phase','attribute','value'})do
            local w,g,_,_,_,rs=launch(function(w)tag(w,'Fire')end)
            if mode=='phase'then rs:SetAttribute('RoundState','Intermission')
            elseif mode=='attribute'then w.player:SetAttribute('InRound',false)
            else make(w,'BoolValue','InRound',w.player,{Value=false})end
            click(g,'DisasterPredictionManual');w.step(10)
            equal(text(g),'Error, You are not in an active round');dispose(w,g)
        end
    end)
    test('manual does not replay the previous character after death or respawn',function()
        local w,g,c,h=launch(function(w)tag(w,'Fire')end);click(g,'DisasterPrediction');w.step(10)
        equal(text(g),'Fire');h.Health=0;h.Died:Fire();w.character()
        click(g,'DisasterPredictionManual');w.step(10);equal(text(g),'Error, You are not in an active round')
        equal(g:GetAttribute('DisasterPredictionEnabled'),true)
        tag(w,'Tsunami');w.step(10);equal(text(g),'Tsunami')
        w.step(240);click(g,'DisasterPredictionManual');w.step(10);equal(text(g),'Tsunami')
        dispose(w,g)
    end)
    test('a phase discovered later in the initial scan prevents stale automatic alerts',function()
        local w,g=launch(function(w,rs)
            tag(w,'Tsunami')
            local state=make(w,'Folder','RoundData',rs)
            state:SetAttribute('RoundPhase','Intermission')
        end)
        click(g,'DisasterPrediction');w.step(10);equal(notices(g),0)
        click(g,'DisasterPredictionManual');w.step(10);equal(text(g),'Error, You are not in an active round')
        dispose(w,g)
    end)
    test('removed and cleared survival tags invalidate manual results',function()
        for _,mode in ipairs({'removed','cleared'})do
            local w,g=launch();local t=tag(w,'Blizzard');click(g,'DisasterPrediction');w.step(10)
            if mode=='removed'then t:Destroy()else t.Value=''end
            click(g,'DisasterPredictionManual');w.step(10);equal(text(g),'Error, You are not in an active round')
            dispose(w,g)
        end
    end)
    test('static catalogs, other players, chat and our notice never count as signals',function()
        local w,g,_,_,_,rs=launch();click(g,'DisasterPrediction');w.step(10)
        local catalog=make(w,'Folder','LabHandler',rs)
        for _,name in ipairs({'Tornado','Fire','Tsunami'})do make(w,'ModuleScript',name,catalog)end
        make(w,'StringValue','CurrentDisaster',catalog,{Value='Fire'})
        tag(w,'Tsunami',make(w,'Model','OtherPlayer',w.env.workspace))
        local chat=make(w,'ScreenGui','TextChatService',w.pg)
        make(w,'TextLabel','Message',chat,{Text='DISASTER WARNING: Tornado!'})
        w.step(20);equal(notices(g),0)
        click(g,'DisasterPredictionManual');w.step(10);equal(notices(g),1);w.step(30);equal(notices(g),1)
        dispose(w,g)
    end)
    test('remote start signals work; end signals and round changes invalidate cached data',function()
        local w,g,_,_,_,rs=launch();w.player:SetAttribute('InRound',true)
        local event=make(w,'RemoteEvent','DisasterStarted',rs)
        local round=make(w,'RemoteEvent','RoundEnded',rs)
        click(g,'DisasterPrediction');w.step(10)
        event.OnClientEvent:Fire({Disasters={'Volcano','Avalanche'}});w.step(10)
        equal(text(g),'Avalanche · Volcanic Eruption')
        local count=notices(g);event.OnClientEvent:Fire({Disaster='Fire',Action='stop'});w.step(10);equal(notices(g),count)
        round.OnClientEvent:Fire();click(g,'DisasterPredictionManual');w.step(10)
        equal(text(g),'Error, You are not in an active round')
        dispose(w,g);equal(event.OnClientEvent:Count(),0);equal(round.OnClientEvent:Count(),0)
    end)
    test('map replacement allows the same disaster in a subsequent round',function()
        local w,g=launch();local structure=make(w,'Model','Structure',w.env.workspace)
        local t=tag(w,'Tornado');click(g,'DisasterPrediction');w.step(10);equal(notices(g),1)
        t.Value='';structure:Destroy();make(w,'Model','Structure',w.env.workspace)
        t.Value='Tornado';w.step(10);equal(notices(g),2);dispose(w,g)
    end)
    test('hidden warning is ignored; late warning text is discovered without a tag',function()
        local w,g=launch();local banner=make(w,'ScreenGui','DisasterWarning',w.pg,{Enabled=false})
        local label=make(w,'TextLabel','Message',banner,{Text='Sandstorm! Avoid flying objects.'})
        click(g,'DisasterPrediction');w.step(10);equal(notices(g),0)
        banner.Enabled=true;w.step(10);equal(text(g),'Sandstorm')
        local generic=make(w,'TextLabel','Announcement',w.pg,{Text=''})
        generic.Text='DISASTER WARNING: Earthquake! Get outside.';w.step(10)
        assert(text(g):find('Earthquake'));dispose(w,g)
    end)
    test('top-right notice fades and slides, holds five full seconds and exits to the right',function()
        local w,g=launch();click(g,'DisasterPredictionManual');w.step(2)
        local toast=find(g,'DisasterNotification');local face=find(toast,'DisasterFace')
        assert(toast.Visible and toast.Position.X.Offset>0);assert(face.BackgroundTransparency>.5)
        equal(toast.AnchorPoint.X,1);equal(toast.AnchorPoint.Y,0);equal(toast.Position.Y.Scale,0);equal(toast.Position.Y.Offset,16)
        w.step(23);equal(g:GetAttribute('DisasterNotification'),'holding');equal(toast.Position.X.Offset,-16)
        assert(face.BackgroundTransparency<.01)
        w.step(288);equal(g:GetAttribute('DisasterNotification'),'holding')
        w.step(10);equal(g:GetAttribute('DisasterNotification'),'exiting');w.step(2);assert(toast.Position.X.Offset>-16)
        w.step(20);assert(not toast.Visible);equal(g:GetAttribute('DisasterNotification'),'hidden')
        dispose(w,g)
    end)
    test('compact notice centers supplied success/failure art and uses a readable fallback until loaded',function()
        local w,g=launch();local toast=find(g,'DisasterNotification')
        equal(toast.Size.X.Offset,318);equal(toast.Size.Y.Offset,88)
        equal(g:GetAttribute('DisasterNoticeDuration'),5)
        local badge=find(toast,'DisasterBadge');equal(badge.Position.Y.Scale,.5);equal(badge.Position.Y.Offset,0)
        equal(badge.AnchorPoint.Y,.5);equal(badge.Size.X.Offset,52)
        local success,failure=find(toast,'DisasterSuccessIcon'),find(toast,'DisasterFailureIcon')
        local sf,ff=find(toast,'DisasterSuccessFallback'),find(toast,'DisasterFailureFallback')
        click(g,'DisasterPredictionManual');w.step(30)
        assert(ff.Visible and not sf.Visible and not failure.Visible)
        failure.Image='mock://failure';failure.IsLoaded=true;w.step(20)
        assert(failure.Visible and not success.Visible and not ff.Visible)
        assert(find(toast,'DisasterFailureGlow').Visible)
        local spark=find(toast,'DisasterIconGlint');local start=spark.Position;w.step(15)
        assert(spark.Position.X.Offset~=start.X.Offset,'small icon glints animate')
        click(g,'DisasterPrediction');tag(w,'Tsunami');w.step(10)
        assert(sf.Visible and not ff.Visible and not failure.Visible)
        success.Image='mock://success';success.IsLoaded=true;w.step(20)
        assert(success.Visible and not failure.Visible and not sf.Visible)
        equal(success.ImageColor3.R,1);equal(success.ImageColor3.G,1);equal(success.ImageColor3.B,1)
        assert(toast:FindFirstChild('DisasterGlyph',true)==nil,'no unsupported font glyph')
        local total=#w.objects;w.step(10);equal(#w.objects,total)
        dispose(w,g)
    end)
    test('notification survives minimizing, folding and dragging Hub off-screen',function()
        local w,g=launch();click(g,'DisasterPrediction');w.step(10)
        click(g,'Minimize');w.step(30);tag(w,'Tsunami');w.step(30)
        assert(find(g,'DisasterNotification').Visible);equal(text(g),'Tsunami')
        find(g,'Launcher').Position=w.env.UDim2.fromOffset(-2000,-2000);w.step(360)
        assert(not find(g,'DisasterNotification').Visible);dispose(w,g)
    end)
    test('notice respects safe-screen dimensions after orientation changes',function()
        local w,g=launch(nil,844,390);click(g,'DisasterPredictionManual');w.step(30)
        w.viewport={X=320,Y=640};find(g,'SafeArea'):GetPropertyChangedSignal('AbsoluteSize'):Fire();w.step(2)
        local toast=find(g,'DisasterNotification');assert(toast.Size.X.Offset<=288)
        assert(toast.AbsolutePosition.X>=15 and toast.AbsolutePosition.X+toast.AbsoluteSize.X<=305)
        assert(not toast.Active);dispose(w,g)
    end)
    test('new notice replaces a current exit without stacking or lingering',function()
        local w,g=launch();click(g,'DisasterPrediction');w.step(10)
        local t=tag(w,'Fire');w.step(326)
        equal(g:GetAttribute('DisasterNotification'),'exiting')
        local total=#w.objects;t.Value='Fire,Tsunami';w.step(30)
        equal(text(g),'Fire · Tsunami');equal(g:GetAttribute('DisasterNotification'),'holding');equal(#w.objects,total)
        w.step(340);assert(not find(g,'DisasterNotification').Visible);dispose(w,g)
    end)
    test('OFF cancels scans and stale events; rapid toggles never duplicate watchers',function()
        local w,g,_,_,_,rs=launch();local event=make(w,'RemoteEvent','DisasterStarted',rs)
        for _=1,8 do
            click(g,'DisasterPrediction');w.step(3);equal(event.OnClientEvent:Count(),1)
            click(g,'DisasterPrediction');equal(event.OnClientEvent:Count(),0)
        end
        click(g,'DisasterPrediction');w.step(3)
        local stale=event.OnClientEvent.links[#event.OnClientEvent.links].fn
        click(g,'DisasterPrediction');stale('Fire');w.step(10);equal(notices(g),0)
        dispose(w,g)
    end)
    test('closing during a yielded manual lookup never displays a late notice',function()
        local w,g,_,_,_,rs=launch()
        for i=1,700 do make(w,'Folder','Unrelated'..i,rs)end
        click(g,'DisasterPredictionManual');w.step();click(g,'Close');w.step(40)
        equal(g.Parent,nil);equal(notices(g),0);equal(w.services.RunService.Heartbeat:Count(),0)
        equal(w.env.workspace.DescendantAdded:Count(),0)
    end)
    test('rerun starts OFF and destroys the previous detector and notice',function()
        local w,g,_,_,_,rs=launch();local event=make(w,'RemoteEvent','DisasterStarted',rs)
        click(g,'DisasterPrediction');w.step(10);event.OnClientEvent:Fire('Fire');w.step(10)
        local fresh=w.run(source);w.step(35)
        equal(g.Parent,nil);equal(fresh:GetAttribute('DisasterPredictionEnabled'),false)
        equal(event.OnClientEvent:Count(),0);equal(notices(fresh),0);dispose(w,fresh)
    end)
    test('all existing character features and flight keep their state while detector toggles',function()
        local w,g=launch();tag(w,'Tornado')
        for _,name in ipairs({'NoFallDamage','WalkOnWater','Antifling'})do click(g,name)end
        click(g,'FlySS3FE');local fly=find(w.pg,'FlyDBZ');click(fly,'FlightToggle');w.step(10)
        click(g,'DisasterPrediction');w.step(10);click(g,'DisasterPredictionManual');w.step(10)
        equal(text(g),'Tornado');click(g,'DisasterPrediction')
        for _,name in ipairs({'NoFallDamage','WalkOnWater','Antifling'})do equal(g:GetAttribute(name..'Enabled'),true)end
        equal(fly:GetAttribute('FlightEnabled'),true);equal(fly:GetAttribute('NoFallDamageArmed'),false)
        dispose(w,g)
    end)
    test('idle observer is passive, bounded and does not scan or allocate per frame',function()
        local w,g=launch();click(g,'DisasterPrediction');w.step(330)
        local scans,total=w.descendantScans,#w.objects;local writes=w.velocityWrites
        w.step(120);equal(w.descendantScans,scans);equal(#w.objects,total);equal(w.velocityWrites,writes)
        dispose(w,g)
    end)
    test('unsupported places keep toggle OFF and manual errors respect cooldown',function()
        local w,g=launch(function(w)w.env.game.PlaceId=1 end)
        click(g,'DisasterPrediction');equal(g:GetAttribute('DisasterPredictionEnabled'),false)
        click(g,'DisasterPredictionManual');w.step(10);equal(text(g),'Error, You are not in an active round')
        local n=notices(g);click(g,'DisasterPredictionManual');equal(notices(g),n)
        equal(w.env.workspace.DescendantAdded:Count(),0);dispose(w,g)
    end)
    print(tostring(passed)..' disaster integration scenarios passed')
end
